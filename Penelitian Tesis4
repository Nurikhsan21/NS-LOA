    "    return (x_train, y_train), (x_test, y_test), class_names\n",
    "\n",
    "\n",
    "print(\"=\" * 60)\n",
    "print(\"LOADING CIFAR-10\")\n",
    "print(\"=\" * 60)\n",
    "(x_train_full, y_train_full), (x_test_full, y_test_full), class_names = load_cifar10_kaggle()\n",
